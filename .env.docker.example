#   postgresql://user:pass@localhost:5432/ubnd_db?schema=public
#   postgresql://user:pass@10.0.0.5:5432/ubnd_db?schema=public
#   postgresql://user:pass@host.docker.internal:5432/ubnd_db?schema=public
DATABASE_URL=
MAIL_PASS=
MAIL_USER=
OTP_EXPIRE_MINUTES=5
CORS_ORIGIN=*
