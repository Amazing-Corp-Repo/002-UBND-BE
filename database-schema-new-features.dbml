// UBND - Database Schema MỚI: Tiếp dân quầy + Đăng ký gặp lãnh đạo
// ============================================================
// Sinh từ plan-refine-dang-ky-tiep-dan.md
// Xem diagram tại: https://dbdiagram.io/d
// ============================================================

Table quay_tiep_dan {
  id uuid [pk]
  ma_quay varchar(20) [unique]
  ten_quay varchar(100)
  so_thu_tu int [unique]
  mo_ta text
  suc_chua_mac_dinh int [default: 2, note: '>= 1']
  vi_tri varchar(255)
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]
}

Table lich_tiep_dan {
  id uuid [pk]
  dia_diem varchar(255)
  ten_can_bo varchar(255)
  thoi_gian varchar(50)
  ngay_tiep_dan date
  ghi_chu varchar(255)
  is_active bool
  is_delete bool
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp
  thoi_gian_cap_nhat timestamp
}

Table khung_gio_tiep_dan {
  id uuid [pk]
  id_lich_tiep_dan uuid [ref: > lich_tiep_dan.id]
  khung_gio varchar(50)
  id_quay uuid [ref: > quay_tiep_dan.id, note: 'THÊM MỚI - giữ ma_quay cũ']
  ma_quay varchar(20) [note: 'CŨ - sẽ xoá Phase 3']
  is_active bool
  is_delete bool
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp
  thoi_gian_cap_nhat timestamp

  indexes {
    (id_lich_tiep_dan, khung_gio, id_quay) [unique]
  }
}

Table dang_ky_tiep_dan {
  id uuid [pk]
  ma_tiep_dan varchar(50) [unique]
  id_lich_tiep_dan uuid [ref: > lich_tiep_dan.id]
  id_khung_gio_tiep_dan uuid [ref: > khung_gio_tiep_dan.id, note: 'THÊM MỚI']
  id_quay uuid [ref: > quay_tiep_dan.id, note: 'THÊM MỚI - giữ bo_phan cũ']
  ngay date
  slot varchar(50)
  chu_de varchar(255)
  ly_do text
  ho_ten varchar(150)
  sdt varchar(20)
  cccd varchar(20)
  cccd_ngay_cap date
  cccd_noi_cap text
  dia_chi text [note: 'GIỮ - Mobile đang dùng']
  bo_phan text [note: 'CŨ - sẽ xoá Phase 3']
  ten_lanh_dao varchar(255) [note: 'CŨ - sẽ xoá Phase 3']
  chuc_vu_lanh_dao varchar(255) [note: 'CŨ - sẽ xoá Phase 3']
  loai varchar(30) [note: 'CŨ - sẽ xoá Phase 3']
  trang_thai varchar(30) [default: 'PENDING']
  thoi_gian_phe_duyet timestamp
  thoi_gian_hoan_thanh timestamp
  nguoi_hoan_thanh uuid
  ly_do_tu_choi text
  thoi_gian_tu_choi timestamp
  nguoi_tu_choi uuid
  nguoi_duyet_don uuid [ref: > nguoi_dung.id, note: 'THÊM MỚI']
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp
  thoi_gian_cap_nhat timestamp
  is_active bool
  is_delete bool
}

Table danh_gia_tiep_dan {
  id uuid [pk]
  id_dang_ky_tiep_dan uuid [unique, ref: > dang_ky_tiep_dan.id]
  diem_tong int
  tieu_chi json
  ly_do json
  nhan_xet text
  is_active bool
  is_delete bool
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp
  thoi_gian_cap_nhat timestamp
}

// ═══════════════════════════════════════════════════════════
// HỆ THỐNG ĐĂNG KÝ GẶP LÃNH ĐẠO (MỚI)
// ═══════════════════════════════════════════════════════════

Table lich_gap_lanh_dao {
  id uuid [pk]
  id_lanh_dao uuid [ref: > nguoi_dung.id, note: 'Lãnh đạo phụ trách']
  ngay date [note: 'Ngày gặp']
  dia_diem varchar(255) [note: 'Địa điểm / phòng gặp']
  ghi_chu text
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]

  indexes {
    (id_lanh_dao, ngay) [unique]
  }
}

Table khung_gio_gap_lanh_dao {
  id uuid [pk]
  id_lich_gap uuid [ref: > lich_gap_lanh_dao.id]
  gio_bat_dau varchar(10) [note: 'VD: 08:00']
  gio_ket_thuc varchar(10) [note: 'VD: 08:30']
  suc_chua int [default: 1, note: '>= 1']
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]

  indexes {
    (id_lich_gap, gio_bat_dau, gio_ket_thuc) [unique]
  }
}

Table dang_ky_gap_lanh_dao {
  id uuid [pk]
  ma_dang_ky varchar(50) [unique]
  id_khung_gio_gap uuid [ref: > khung_gio_gap_lanh_dao.id]
  ho_ten varchar(150)
  sdt varchar(20)
  cccd varchar(20)
  ngay_cap_cccd date
  noi_cap_cccd varchar(255)
  dia_chi text
  ngay_lam_don date
  ly_do text
  trang_thai varchar(30) [default: 'PENDING', note: 'PENDING | APPROVED | REJECTED | COMPLETED']
  thoi_gian_phe_duyet timestamp
  thoi_gian_hoan_thanh timestamp
  thoi_gian_tu_choi timestamp
  ly_do_tu_choi text
  nguoi_duyet_don uuid [ref: > nguoi_dung.id]
  nguoi_hoan_thanh uuid [ref: > nguoi_dung.id]
  nguoi_tu_choi uuid [ref: > nguoi_dung.id]
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]
}

Table dinh_kem_dang_ky_gap_lanh_dao {
  id uuid [pk]
  id_dang_ky uuid [ref: > dang_ky_gap_lanh_dao.id]
  loai_dinh_kem varchar(30) [note: 'CCCD_FRONT | CCCD_BACK | SUPPORTING_DOCUMENT']
  ten_file_goc varchar(255)
  duong_dan_file text
  mime_type varchar(100)
  kich_thuoc int [note: 'bytes, >= 0']
  thoi_gian_tao timestamp [default: `now()`]
}

Table danh_gia_gap_lanh_dao {
  id uuid [pk]
  id_dang_ky_gap_lanh_dao uuid [unique, ref: > dang_ky_gap_lanh_dao.id]
  diem_tong int [note: 'BETWEEN 1 AND 5']
  tieu_chi json
  ly_do json
  nhan_xet text
  is_active bool [default: true]
  is_delete bool [default: false]
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]
}

// ═══════════════════════════════════════════════════════════
// THAM CHIẾU: nguoi_dung (các bảng khác dùng làm FK)
// ═══════════════════════════════════════════════════════════

Table nguoi_dung {
  id uuid [pk]
  ten_dang_nhap varchar(100)
  mat_khau varchar(255)
  ho_va_ten varchar(150)
  email varchar(150)
  so_dien_thoai varchar(20)
  is_enable_two_factor bool
  is_active bool
  is_delete bool
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp
  thoi_gian_cap_nhat timestamp
  fcm_token varchar[]
}

// ═══════════════════════════════════════════════════════════
// QUAN HỆ (REFERENCES)
// ═══════════════════════════════════════════════════════════

// Quầy
Ref: khung_gio_tiep_dan.id_quay > quay_tiep_dan.id
Ref: dang_ky_tiep_dan.id_quay > quay_tiep_dan.id

// Khung giờ tiếp dân
Ref: dang_ky_tiep_dan.id_khung_gio_tiep_dan > khung_gio_tiep_dan.id
Ref: dang_ky_tiep_dan.id_lich_tiep_dan > lich_tiep_dan.id

// Đánh giá tiếp dân
Ref: danh_gia_tiep_dan.id_dang_ky_tiep_dan > dang_ky_tiep_dan.id

// Người duyệt đơn
Ref: dang_ky_tiep_dan.nguoi_duyet_don > nguoi_dung.id

// Lịch gặp lãnh đạo
Ref: lich_gap_lanh_dao.id_lanh_dao > nguoi_dung.id

// Khung giờ gặp lãnh đạo
Ref: khung_gio_gap_lanh_dao.id_lich_gap > lich_gap_lanh_dao.id

// Đăng ký gặp lãnh đạo -> khung giờ
Ref: dang_ky_gap_lanh_dao.id_khung_gio_gap > khung_gio_gap_lanh_dao.id

// Người xử lý đơn gặp lãnh đạo
Ref: dang_ky_gap_lanh_dao.nguoi_duyet_don > nguoi_dung.id
Ref: dang_ky_gap_lanh_dao.nguoi_hoan_thanh > nguoi_dung.id
Ref: dang_ky_gap_lanh_dao.nguoi_tu_choi > nguoi_dung.id

// Đính kèm đăng ký gặp lãnh đạo
Ref: dinh_kem_dang_ky_gap_lanh_dao.id_dang_ky > dang_ky_gap_lanh_dao.id

// Đánh giá gặp lãnh đạo
Ref: danh_gia_gap_lanh_dao.id_dang_ky_gap_lanh_dao > dang_ky_gap_lanh_dao.id

// Audit
Ref: quay_tiep_dan.nguoi_tao > nguoi_dung.id
Ref: quay_tiep_dan.nguoi_cap_nhat > nguoi_dung.id
Ref: lich_gap_lanh_dao.nguoi_tao > nguoi_dung.id
Ref: lich_gap_lanh_dao.nguoi_cap_nhat > nguoi_dung.id
Ref: khung_gio_gap_lanh_dao.nguoi_tao > nguoi_dung.id
Ref: khung_gio_gap_lanh_dao.nguoi_cap_nhat > nguoi_dung.id
Ref: dang_ky_gap_lanh_dao.nguoi_tao > nguoi_dung.id
Ref: dang_ky_gap_lanh_dao.nguoi_cap_nhat > nguoi_dung.id
Ref: dang_ky_tiep_dan.nguoi_tao > nguoi_dung.id
Ref: dang_ky_tiep_dan.nguoi_cap_nhat > nguoi_dung.id