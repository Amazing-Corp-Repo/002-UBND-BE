// UBND — Database Schema (đồng bộ từ prisma/schema.prisma)
// ============================================================
// Cập nhật: 2026-08-22 — bao gồm Tiếp dân quầy V2, Gặp lãnh đạo, Thư viện số
// ============================================================

// ═══════════════════════════════════════════════════════════
// TIẾP DÂN & ĐĂNG KÝ TIẾP DÂN
// ═══════════════════════════════════════════════════════════

Table quay_tiep_dan {
  id uuid [pk]
  ma_quay varchar(20) [unique]
  ten_quay varchar(100)
  so_thu_tu int [unique]
  mo_ta text
  suc_chua_mac_dinh int [default: 2]
  vi_tri varchar(255)
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]
}

Table lich_tiep_dan {
  id uuid [pk]
  dia_diem varchar(255)
  ten_can_bo varchar(255)
  thoi_gian varchar(50)
  ngay_tiep_dan date
  ghi_chu varchar(255)
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]
}

// Ca tiếp dân — khung thời gian trong lịch, không gắn sẵn quầy
Table ca_tiep_dan {
  id uuid [pk]
  id_lich_tiep_dan uuid [ref: > lich_tiep_dan.id]
  gio_bat_dau time
  gio_ket_thuc time
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]

  indexes {
    (id_lich_tiep_dan, gio_bat_dau, gio_ket_thuc) [unique]
  }
}

// Cấu hình quầy cho từng khung giờ / ca
Table khung_gio_tiep_dan {
  id uuid [pk]
  id_lich_tiep_dan uuid [ref: > lich_tiep_dan.id]
  khung_gio varchar(50)
  ma_quay varchar(20) [note: 'CŨ — giữ lại']
  id_quay uuid [ref: > quay_tiep_dan.id, note: 'V2 canonical']
  id_ca_tiep_dan uuid [ref: > ca_tiep_dan.id, note: 'V2 canonical']
  suc_chua int [default: 2]
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]

  indexes {
    (id_lich_tiep_dan, khung_gio, id_quay) [unique]
    (id_ca_tiep_dan, id_quay) [unique, note: 'unique per ca+quay V2']
  }
}

// Phân công cán bộ trực quầy theo ca
Table phan_cong_quay_tiep_dan {
  id uuid [pk]
  id_cau_hinh_quay uuid [ref: > khung_gio_tiep_dan.id]
  id_can_bo uuid [ref: > nguoi_dung.id]
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]
}

Table dang_ky_tiep_dan {
  id uuid [pk]
  loai varchar(30) [note: 'COUNTER_RECEPTION | LEADER_MEETING']
  ma_tiep_dan varchar(50) [unique]
  id_lich_tiep_dan uuid [ref: > lich_tiep_dan.id]
  id_khung_gio_tiep_dan uuid [ref: > khung_gio_tiep_dan.id, note: 'V1 legacy — fallback']
  id_quay uuid [ref: > quay_tiep_dan.id, note: 'V1 legacy — fallback']
  id_ca_tiep_dan uuid [ref: > ca_tiep_dan.id, note: 'V2 canonical']
  id_cau_hinh_quay uuid [ref: > khung_gio_tiep_dan.id, note: 'V2 canonical — gán khi duyệt']
  ngay date
  slot varchar(50)
  chu_de varchar(255)
  ly_do text
  ho_ten varchar(150)
  sdt varchar(20)
  cccd varchar(20)
  dia_chi text
  bo_phan text [note: 'CŨ — sẽ xoá Phase 3']
  ten_lanh_dao varchar(255) [note: 'CŨ — sẽ xoá Phase 3']
  chuc_vu_lanh_dao varchar(255) [note: 'CŨ — sẽ xoá Phase 3']
  trang_thai varchar(30) [default: 'PENDING']
  thoi_gian_phe_duyet timestamp
  thoi_gian_hoan_thanh timestamp
  nguoi_hoan_thanh uuid
  ly_do_tu_choi text
  thoi_gian_tu_choi timestamp
  nguoi_tu_choi uuid
  nguoi_duyet_don uuid [ref: > nguoi_dung.id]
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]
}

Table danh_gia_tiep_dan {
  id uuid [pk]
  id_dang_ky_tiep_dan uuid [unique, ref: > dang_ky_tiep_dan.id]
  diem_tong int
  tieu_chi json
  ly_do json
  nhan_xet text
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]
}

// ═══════════════════════════════════════════════════════════
// HỆ THỐNG ĐĂNG KÝ GẶP LÃNH ĐẠO
// ═══════════════════════════════════════════════════════════

Table lich_gap_lanh_dao {
  id uuid [pk]
  id_lanh_dao uuid [ref: > nguoi_dung.id]
  ngay date
  dia_diem varchar(255)
  ghi_chu text
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]

  indexes {
    (id_lanh_dao, ngay) [unique]
  }
}

Table khung_gio_gap_lanh_dao {
  id uuid [pk]
  id_lich_gap uuid [ref: > lich_gap_lanh_dao.id]
  gio_bat_dau varchar(10)
  gio_ket_thuc varchar(10)
  suc_chua int [default: 1]
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]

  indexes {
    (id_lich_gap, gio_bat_dau, gio_ket_thuc) [unique]
  }
}

Table dang_ky_gap_lanh_dao {
  id uuid [pk]
  ma_dang_ky varchar(50) [unique]
  id_khung_gio_gap uuid [ref: > khung_gio_gap_lanh_dao.id]
  ngay_hen date [note: 'Ngày hẹn gặp']
  chu_de varchar(255) [note: 'Chủ đề gặp lãnh đạo']
  ho_ten varchar(150)
  sdt varchar(20)
  cccd varchar(20)
  ngay_cap_cccd date
  noi_cap_cccd varchar(255)
  dia_chi text
  ngay_lam_don date
  ly_do text
  trang_thai varchar(30) [default: 'PENDING']
  thoi_gian_phe_duyet timestamp
  thoi_gian_bat_dau_xu_ly timestamp
  thoi_gian_hoan_thanh timestamp
  thoi_gian_tu_choi timestamp
  thoi_gian_huy timestamp
  ly_do_tu_choi text
  ly_do_huy text
  ghi_chu_xu_ly text
  ghi_chu_hoan_thanh text
  nguoi_duyet_don uuid [ref: > nguoi_dung.id]
  nguoi_bat_dau_xu_ly uuid [ref: > nguoi_dung.id]
  nguoi_hoan_thanh uuid [ref: > nguoi_dung.id]
  nguoi_tu_choi uuid [ref: > nguoi_dung.id]
  nguoi_huy uuid [ref: > nguoi_dung.id]
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]

  indexes {
    (id_khung_gio_gap, sdt) [unique]
    (id_khung_gio_gap, cccd) [unique]
  }
}

Table dinh_kem_dang_ky_gap_lanh_dao {
  id uuid [pk]
  id_dang_ky uuid [ref: > dang_ky_gap_lanh_dao.id]
  loai_dinh_kem varchar(30) [note: 'CCCD_FRONT | CCCD_BACK | SUPPORTING_DOCUMENT']
  ten_file_goc varchar(255)
  duong_dan_file text
  mime_type varchar(100)
  kich_thuoc int [note: 'bytes']
  thoi_gian_tao timestamp [default: `now()`]
}

Table danh_gia_gap_lanh_dao {
  id uuid [pk]
  id_dang_ky_gap_lanh_dao uuid [unique, ref: > dang_ky_gap_lanh_dao.id]
  diem_tong int
  tieu_chi json
  ly_do json
  nhan_xet text
  is_active bool [default: true]
  is_delete bool [default: false]
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]
}

// ═══════════════════════════════════════════════════════════
// THƯ VIỆN SỐ
// ═══════════════════════════════════════════════════════════

Table thu_vien_danh_muc {
  id uuid [pk]
  ten varchar(255)
  mo_ta text
  icon varchar(50)
  tone varchar(20)
  thu_tu int
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]
}

Table thu_vien_tai_lieu {
  id uuid [pk]
  id_danh_muc uuid [ref: > thu_vien_danh_muc.id]
  loai varchar(30) [note: 'SACH | TAI_LIEU | VAN_BAN | BAN_DO | PHAP_LUAT | VAN_HOA']
  tieu_de varchar(255)
  tac_gia varchar(255)
  mo_ta text
  url_bia varchar(500)
  so_luot_tai bigint [default: 0]
  is_featured bool [default: false]
  noi_dung text
  sections json
  so_hieu varchar(100)
  co_quan_ban_hanh varchar(255)
  ngay_ban_hanh date
  ngay_hieu_luc date
  trang_thai_hieu_luc varchar(50)
  chuong json
  trang_thai varchar(30) [default: 'NHAP', note: 'NHAP|CHO_DUYET|DA_DUYET|LUU_TRU']
  pham_vi varchar(30) [default: 'CONG_KHAI', note: 'CONG_KHAI|NOI_BO|HAN_CHE']
  nguon text
  nguoi_duyet uuid
  thoi_gian_duyet timestamp
  ngay_dang int
  ngon_ngu varchar(10)
  // Task 4: Kho tư liệu & Tra cứu văn bản
  luot_xem bigint [default: 0]
  ai_da_hoc bool [default: false]
  thoi_gian_ai_hoc timestamp
  ngay_het_han date
  dia_chi varchar(500) [note: 'cho văn hóa']
  ten_di_tich varchar(255) [note: 'cho văn hóa']
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]
}

Table thu_vien_tai_lieu_media {
  id uuid [pk]
  id_tai_lieu uuid [ref: > thu_vien_tai_lieu.id]
  loai varchar(10) [note: 'IMAGE | VIDEO']
  ten_file_goc varchar(255)
  url varchar(500)
  kich_thuoc bigint [note: 'bytes']
  mime_type varchar(50)
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  thoi_gian_tao timestamp [default: `now()`]
}

Table thu_vien_tag {
  id uuid [pk]
  ten varchar(100) [unique]
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]
}

Table thu_vien_tai_lieu_tag {
  id uuid [pk]
  id_tai_lieu uuid [ref: > thu_vien_tai_lieu.id]
  id_tag uuid [ref: > thu_vien_tag.id]

  indexes {
    (id_tai_lieu, id_tag) [unique]
  }
}

Table thu_vien_tai_lieu_file {
  id uuid [pk]
  id_tai_lieu uuid [ref: > thu_vien_tai_lieu.id]
  ten_file varchar(255)
  duong_dan varchar(500)
  dinh_dang varchar(50) [note: 'MIME']
  kich_thuoc_mb decimal(10, 2)
  phien_ban int
  la_phien_ban_hien_tai bool [default: false]
  mo_ta text
  is_active bool [default: true]
  is_delete bool [default: false]
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]
}

Table thu_vien_tai_lieu_quyen {
  id uuid [pk]
  id_tai_lieu uuid [ref: > thu_vien_tai_lieu.id]
  id_vai_tro uuid [ref: > roles.id, note: 'FK tới roles — quyền truy cập HAN_CHE']
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp [default: `now()`]
  thoi_gian_cap_nhat timestamp [default: `now()`]
}

// ═══════════════════════════════════════════════════════════
// THAM CHIẾU: nguoi_dung & roles (các bảng khác dùng FK)
// ═══════════════════════════════════════════════════════════

Table nguoi_dung {
  id uuid [pk]
  ten_dang_nhap varchar(100)
  mat_khau varchar(255)
  ho_va_ten varchar(150)
  email varchar(150)
  so_dien_thoai varchar(20)
  is_enable_two_factor bool
  is_active bool
  is_delete bool
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp
  thoi_gian_cap_nhat timestamp
  fcm_token varchar[]
}

Table roles {
  id uuid [pk]
  name varchar(150) [unique]
  description text
  is_active bool
  is_delete bool
  nguoi_tao uuid
  nguoi_cap_nhat uuid
  thoi_gian_tao timestamp
  thoi_gian_cap_nhat timestamp
}

// ═══════════════════════════════════════════════════════════
// QUAN HỆ AUDIT — các cột nguoi_tao / nguoi_cap_nhat (không inline ref)
// ═══════════════════════════════════════════════════════════

Ref: quay_tiep_dan.nguoi_tao > nguoi_dung.id
Ref: quay_tiep_dan.nguoi_cap_nhat > nguoi_dung.id
Ref: lich_tiep_dan.nguoi_tao > nguoi_dung.id
Ref: lich_tiep_dan.nguoi_cap_nhat > nguoi_dung.id
Ref: ca_tiep_dan.nguoi_tao > nguoi_dung.id
Ref: ca_tiep_dan.nguoi_cap_nhat > nguoi_dung.id
Ref: khung_gio_tiep_dan.nguoi_tao > nguoi_dung.id
Ref: khung_gio_tiep_dan.nguoi_cap_nhat > nguoi_dung.id
Ref: phan_cong_quay_tiep_dan.nguoi_tao > nguoi_dung.id
Ref: phan_cong_quay_tiep_dan.nguoi_cap_nhat > nguoi_dung.id
Ref: dang_ky_tiep_dan.nguoi_tao > nguoi_dung.id
Ref: dang_ky_tiep_dan.nguoi_cap_nhat > nguoi_dung.id
Ref: lich_gap_lanh_dao.nguoi_tao > nguoi_dung.id
Ref: lich_gap_lanh_dao.nguoi_cap_nhat > nguoi_dung.id
Ref: khung_gio_gap_lanh_dao.nguoi_tao > nguoi_dung.id
Ref: khung_gio_gap_lanh_dao.nguoi_cap_nhat > nguoi_dung.id
Ref: dang_ky_gap_lanh_dao.nguoi_tao > nguoi_dung.id
Ref: dang_ky_gap_lanh_dao.nguoi_cap_nhat > nguoi_dung.id
Ref: thu_vien_danh_muc.nguoi_tao > nguoi_dung.id
Ref: thu_vien_danh_muc.nguoi_cap_nhat > nguoi_dung.id
Ref: thu_vien_tai_lieu.nguoi_tao > nguoi_dung.id
Ref: thu_vien_tai_lieu.nguoi_cap_nhat > nguoi_dung.id