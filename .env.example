PORT=8880
PREFIX_API=/api
ADMIN_PASSWORD=
ADMIN_USERNAME=
ADMIN_EMAIL=admin@example.com
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=25h
REFRESH_TOKEN_EXPIRES_IN=90d
APP_NAME=My App
DATABASE_URL=
# Tùy chọn — chỉ dùng cho Prisma CLI (migrate/db). Trỏ tới user OWNER bảng (vd ubnd_admin)
# để chạy được DDL. Bỏ trống thì CLI fallback về DATABASE_URL. Runtime KHÔNG dùng biến này.
MIGRATE_DATABASE_URL=
MAIL_PASS=
MAIL_USER=
OTP_EXPIRE_MINUTES=
CORS_ORIGIN=
# If empty => allow all (*)
# If set => allow only that domain or multiple domains (comma separated)
#
# Examples:
#   CORS_ORIGIN=https://example.com
#   CORS_ORIGIN=https://example.com,https://staging.example.com,http://localhost:3000
# Citizen Web dưới đây đã được whitelist sẵn trong code:
#   https://cong-dan-tangnhonphu-git-update-digital-map-long-d139.vercel.app
RATE_LIMIT_WINDOW_MS=60000     # 60 * 1000 = 1 phút
RATE_LIMIT_MAX=100             # tối đa 100 request / phút
