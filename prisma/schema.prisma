generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model cach_thuc_thuc_hien {
  id                                                        String              @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  id_thu_tuc                                                String?             @db.Uuid
  hinh_thuc_ap_dung                                         String              @db.VarChar(255)
  mo_ta_chi_tiet                                            String?
  thoi_gian_giai_quyet                                      String?
  le_phi                                                    String?             @db.VarChar(255)
  ghi_chu_le_phi                                            String?
  is_active                                                 Boolean?            @default(true)
  is_delete                                                 Boolean?            @default(false)
  nguoi_tao                                                 String?             @db.Uuid
  nguoi_cap_nhat                                            String?             @db.Uuid
  thoi_gian_tao                                             DateTime?           @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat                                        DateTime?           @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  nguoi_dung_cach_thuc_thuc_hien_nguoi_cap_nhatTonguoi_dung nguoi_dung?         @relation("cach_thuc_thuc_hien_nguoi_cap_nhatTonguoi_dung", fields: [nguoi_cap_nhat], references: [id], onUpdate: NoAction, map: "fk_cach_thuc_thuc_hien_nguoi_cap_nhat")
  nguoi_dung_cach_thuc_thuc_hien_nguoi_taoTonguoi_dung      nguoi_dung?         @relation("cach_thuc_thuc_hien_nguoi_taoTonguoi_dung", fields: [nguoi_tao], references: [id], onUpdate: NoAction, map: "fk_cach_thuc_thuc_hien_nguoi_tao")
  thu_tuc_hanh_chinh                                        thu_tuc_hanh_chinh? @relation(fields: [id_thu_tuc], references: [id], onUpdate: NoAction, map: "fk_cach_thuc_thuc_hien_thu_tuc")
}

model co_so_dich_vu_cong {
  id                                                       String               @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  ten_co_so                                                String               @db.VarChar(255)
  dia_chi                                                  String?              @db.VarChar(500)
  so_dien_thoai                                            String?              @db.VarChar(20)
  mo_ta                                                    String?
  link_google_map                                          String?              @db.VarChar(500)
  is_active                                                Boolean?             @default(true)
  is_delete                                                Boolean?             @default(false)
  nguoi_tao                                                String?              @db.Uuid
  nguoi_cap_nhat                                           String?              @db.Uuid
  thoi_gian_tao                                            DateTime?            @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat                                       DateTime?            @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  nguoi_dung_co_so_dich_vu_cong_nguoi_cap_nhatTonguoi_dung nguoi_dung?          @relation("co_so_dich_vu_cong_nguoi_cap_nhatTonguoi_dung", fields: [nguoi_cap_nhat], references: [id], onUpdate: NoAction, map: "fk_dich_vu_cong_nguoi_cap_nhat")
  nguoi_dung_co_so_dich_vu_cong_nguoi_taoTonguoi_dung      nguoi_dung?          @relation("co_so_dich_vu_cong_nguoi_taoTonguoi_dung", fields: [nguoi_tao], references: [id], onUpdate: NoAction, map: "fk_dich_vu_cong_nguoi_tao")
  thu_tuc_hanh_chinh                                       thu_tuc_hanh_chinh[]
}

model linh_vuc {
  id                                             String                        @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  ten_linh_vuc                                   String                        @db.VarChar(255)
  mo_ta                                          String?
  is_active                                      Boolean?                      @default(true)
  is_delete                                      Boolean?                      @default(false)
  nguoi_tao                                      String?                       @db.Uuid
  nguoi_cap_nhat                                 String?                       @db.Uuid
  thoi_gian_tao                                  DateTime?                     @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat                             DateTime?                     @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  nguoi_dung_linh_vuc_nguoi_cap_nhatTonguoi_dung nguoi_dung?                   @relation("linh_vuc_nguoi_cap_nhatTonguoi_dung", fields: [nguoi_cap_nhat], references: [id], onUpdate: NoAction, map: "fk_linh_vuc_nguoi_cap_nhat")
  nguoi_dung_linh_vuc_nguoi_taoTonguoi_dung      nguoi_dung?                   @relation("linh_vuc_nguoi_taoTonguoi_dung", fields: [nguoi_tao], references: [id], onUpdate: NoAction, map: "fk_linh_vuc_nguoi_tao")
  thu_tuc_hanh_chinh_linh_vuc                    thu_tuc_hanh_chinh_linh_vuc[]
}

model mau_don {
  id                                            String                       @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  ten_mau_don                                   String                       @db.VarChar(255)
  mo_ta                                         String?
  ma_mau_don                                    String?                      @db.VarChar(50)
  url_file_pdf                                  String                       @db.VarChar(500)
  kich_thuoc_file_mb                            Decimal?                     @db.Decimal(10, 2)
  is_active                                     Boolean?                     @default(true)
  is_delete                                     Boolean?                     @default(false)
  nguoi_tao                                     String?                      @db.Uuid
  nguoi_cap_nhat                                String?                      @db.Uuid
  thoi_gian_tao                                 DateTime?                    @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat                            DateTime?                    @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  nguoi_dung_mau_don_nguoi_cap_nhatTonguoi_dung nguoi_dung?                  @relation("mau_don_nguoi_cap_nhatTonguoi_dung", fields: [nguoi_cap_nhat], references: [id], onUpdate: NoAction, map: "fk_mau_don_nguoi_cap_nhat")
  nguoi_dung_mau_don_nguoi_taoTonguoi_dung      nguoi_dung?                  @relation("mau_don_nguoi_taoTonguoi_dung", fields: [nguoi_tao], references: [id], onUpdate: NoAction, map: "fk_mau_don_nguoi_tao")
  thu_tuc_hanh_chinh_mau_don                    thu_tuc_hanh_chinh_mau_don[]
}

model nguoi_dung {
  id                                                                               String                       @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  ten_dang_nhap                                                                    String                       @unique @db.VarChar(100)
  mat_khau                                                                         String                       @db.VarChar(255)
  ho_va_ten                                                                        String?                      @db.VarChar(150)
  email                                                                            String?                      @unique @db.VarChar(150)
  so_dien_thoai                                                                    String?                      @db.VarChar(20)
  vai_tro                                                                          String?                      @db.VarChar(20)
  is_enable_two_factor                                                             Boolean?                     @default(false)
  is_active                                                                        Boolean?                     @default(true)
  is_delete                                                                        Boolean?                     @default(false)
  nguoi_tao                                                                        String?                      @db.Uuid
  nguoi_cap_nhat                                                                   String?                      @db.Uuid
  thoi_gian_tao                                                                    DateTime?                    @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat                                                               DateTime?                    @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  cach_thuc_thuc_hien_cach_thuc_thuc_hien_nguoi_cap_nhatTonguoi_dung               cach_thuc_thuc_hien[]        @relation("cach_thuc_thuc_hien_nguoi_cap_nhatTonguoi_dung")
  cach_thuc_thuc_hien_cach_thuc_thuc_hien_nguoi_taoTonguoi_dung                    cach_thuc_thuc_hien[]        @relation("cach_thuc_thuc_hien_nguoi_taoTonguoi_dung")
  co_so_dich_vu_cong_co_so_dich_vu_cong_nguoi_cap_nhatTonguoi_dung                 co_so_dich_vu_cong[]         @relation("co_so_dich_vu_cong_nguoi_cap_nhatTonguoi_dung")
  co_so_dich_vu_cong_co_so_dich_vu_cong_nguoi_taoTonguoi_dung                      co_so_dich_vu_cong[]         @relation("co_so_dich_vu_cong_nguoi_taoTonguoi_dung")
  danh_muc_tin_tuc_danh_muc_tin_tuc_nguoi_cap_nhatTonguoi_dung                     danh_muc_tin_tuc[]           @relation("danh_muc_tin_tuc_nguoi_cap_nhatTonguoi_dung")
  danh_muc_tin_tuc_danh_muc_tin_tuc_nguoi_taoTonguoi_dung                          danh_muc_tin_tuc[]           @relation("danh_muc_tin_tuc_nguoi_taoTonguoi_dung")
  dinh_kem_tin_tuc_dinh_kem_tin_tuc_nguoi_taoTonguoi_dung                          dinh_kem_tin_tuc[]           @relation("dinh_kem_tin_tuc_nguoi_taoTonguoi_dung")
  lich_tiep_dan_lich_tiep_dan_nguoi_cap_nhatTonguoi_dung                           lich_tiep_dan[]              @relation("lich_tiep_dan_nguoi_cap_nhatTonguoi_dung")
  lich_tiep_dan_lich_tiep_dan_nguoi_taoTonguoi_dung                                lich_tiep_dan[]              @relation("lich_tiep_dan_nguoi_taoTonguoi_dung")
  linh_vuc_linh_vuc_nguoi_cap_nhatTonguoi_dung                                     linh_vuc[]                   @relation("linh_vuc_nguoi_cap_nhatTonguoi_dung")
  linh_vuc_linh_vuc_nguoi_taoTonguoi_dung                                          linh_vuc[]                   @relation("linh_vuc_nguoi_taoTonguoi_dung")
  mau_don_mau_don_nguoi_cap_nhatTonguoi_dung                                       mau_don[]                    @relation("mau_don_nguoi_cap_nhatTonguoi_dung")
  mau_don_mau_don_nguoi_taoTonguoi_dung                                            mau_don[]                    @relation("mau_don_nguoi_taoTonguoi_dung")
  otp                                                                              otp[]
  refresh_token                                                                    refresh_token[]
  thanh_phan_ho_so_thanh_phan_ho_so_nguoi_cap_nhatTonguoi_dung                     thanh_phan_ho_so[]           @relation("thanh_phan_ho_so_nguoi_cap_nhatTonguoi_dung")
  thanh_phan_ho_so_thanh_phan_ho_so_nguoi_taoTonguoi_dung                          thanh_phan_ho_so[]           @relation("thanh_phan_ho_so_nguoi_taoTonguoi_dung")
  thu_tuc_hanh_chinh_thu_tuc_hanh_chinh_nguoi_cap_nhatTonguoi_dung                 thu_tuc_hanh_chinh[]         @relation("thu_tuc_hanh_chinh_nguoi_cap_nhatTonguoi_dung")
  thu_tuc_hanh_chinh_thu_tuc_hanh_chinh_nguoi_taoTonguoi_dung                      thu_tuc_hanh_chinh[]         @relation("thu_tuc_hanh_chinh_nguoi_taoTonguoi_dung")
  thu_tuc_hanh_chinh_mau_don_thu_tuc_hanh_chinh_mau_don_nguoi_cap_nhatTonguoi_dung thu_tuc_hanh_chinh_mau_don[] @relation("thu_tuc_hanh_chinh_mau_don_nguoi_cap_nhatTonguoi_dung")
  thu_tuc_hanh_chinh_mau_don_thu_tuc_hanh_chinh_mau_don_nguoi_taoTonguoi_dung      thu_tuc_hanh_chinh_mau_don[] @relation("thu_tuc_hanh_chinh_mau_don_nguoi_taoTonguoi_dung")
  tin_tuc_tin_tuc_nguoi_cap_nhatTonguoi_dung                                       tin_tuc[]                    @relation("tin_tuc_nguoi_cap_nhatTonguoi_dung")
  tin_tuc_tin_tuc_nguoi_taoTonguoi_dung                                            tin_tuc[]                    @relation("tin_tuc_nguoi_taoTonguoi_dung")
  trinh_tu_thuc_hien_thu_tuc_trinh_tu_thuc_hien_thu_tuc_nguoi_cap_nhatTonguoi_dung trinh_tu_thuc_hien_thu_tuc[] @relation("trinh_tu_thuc_hien_thu_tuc_nguoi_cap_nhatTonguoi_dung")
  trinh_tu_thuc_hien_thu_tuc_trinh_tu_thuc_hien_thu_tuc_nguoi_taoTonguoi_dung      trinh_tu_thuc_hien_thu_tuc[] @relation("trinh_tu_thuc_hien_thu_tuc_nguoi_taoTonguoi_dung")
  truong_hop_thu_tuc_truong_hop_thu_tuc_nguoi_cap_nhatTonguoi_dung                 truong_hop_thu_tuc[]         @relation("truong_hop_thu_tuc_nguoi_cap_nhatTonguoi_dung")
  truong_hop_thu_tuc_truong_hop_thu_tuc_nguoi_taoTonguoi_dung                      truong_hop_thu_tuc[]         @relation("truong_hop_thu_tuc_nguoi_taoTonguoi_dung")
  user_session_logs                                                                user_session_logs[]
  uy_ban_uy_ban_nguoi_cap_nhatTonguoi_dung                                         uy_ban[]                     @relation("uy_ban_nguoi_cap_nhatTonguoi_dung")
  uy_ban_uy_ban_nguoi_taoTonguoi_dung                                              uy_ban[]                     @relation("uy_ban_nguoi_taoTonguoi_dung")
}

model otp {
  id            String     @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  id_nguoi_dung String     @db.Uuid
  ma_otp        String     @db.VarChar(10)
  loai_otp      String     @db.VarChar(50)
  expires_at    DateTime   @db.Timestamp(6)
  is_used       Boolean?   @default(false)
  sent_to_email String?    @db.VarChar(150)
  nguoi_dung    nguoi_dung @relation(fields: [id_nguoi_dung], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_otp_nguoi_dung")
}

model refresh_token {
  id                     String     @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  id_nguoi_dung          String     @db.Uuid
  token_hash             String     @unique @db.VarChar(255)
  expires_at             DateTime   @db.Timestamp(6)
  created_by_ip          String?    @db.Inet
  device                 String?    @db.VarChar(100)
  is_revoked             Boolean?   @default(false)
  revoked_by_ip          String?    @db.Inet
  replaced_by_token_hash String?    @db.VarChar(255)
  created_at             DateTime?  @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  updated_at             DateTime?  @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  nguoi_dung             nguoi_dung @relation(fields: [id_nguoi_dung], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_refresh_token_nguoi_dung")
}

model thu_tuc_hanh_chinh {
  id                                                       String                        @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  id_co_so_dich_vu_cong                                    String?                       @db.Uuid
  ten_thu_tuc                                              String                        @db.VarChar(255)
  ma_thu_tuc                                               String?                       @db.VarChar(50)
  doi_tuong_thuc_hien                                      String?                       @db.VarChar(255)
  yeu_cau_dieu_kien_chung                                  String?
  so_quyet_dinh                                            String?                       @db.VarChar(255)
  is_active                                                Boolean?                      @default(true)
  is_delete                                                Boolean?                      @default(false)
  nguoi_tao                                                String?                       @db.Uuid
  nguoi_cap_nhat                                           String?                       @db.Uuid
  thoi_gian_tao                                            DateTime?                     @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat                                       DateTime?                     @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  cach_thuc_thuc_hien                                      cach_thuc_thuc_hien[]
  co_so_dich_vu_cong                                       co_so_dich_vu_cong?           @relation(fields: [id_co_so_dich_vu_cong], references: [id], onUpdate: NoAction, map: "fk_thu_tuc_hanh_chinh_co_so_dich_vu_cong")
  nguoi_dung_thu_tuc_hanh_chinh_nguoi_cap_nhatTonguoi_dung nguoi_dung?                   @relation("thu_tuc_hanh_chinh_nguoi_cap_nhatTonguoi_dung", fields: [nguoi_cap_nhat], references: [id], onUpdate: NoAction, map: "fk_thu_tuc_hanh_chinh_nguoi_cap_nhat")
  nguoi_dung_thu_tuc_hanh_chinh_nguoi_taoTonguoi_dung      nguoi_dung?                   @relation("thu_tuc_hanh_chinh_nguoi_taoTonguoi_dung", fields: [nguoi_tao], references: [id], onUpdate: NoAction, map: "fk_thu_tuc_hanh_chinh_nguoi_tao")
  thu_tuc_hanh_chinh_linh_vuc                              thu_tuc_hanh_chinh_linh_vuc[]
  thu_tuc_hanh_chinh_mau_don                               thu_tuc_hanh_chinh_mau_don[]
  trinh_tu_thuc_hien_thu_tuc                               trinh_tu_thuc_hien_thu_tuc[]
  truong_hop_thu_tuc                                       truong_hop_thu_tuc[]
}

model thu_tuc_hanh_chinh_linh_vuc {
  id                    String             @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  id_thu_tuc_hanh_chinh String             @db.Uuid
  id_linh_vuc           String             @db.Uuid
  nguoi_tao             String?            @db.Uuid
  nguoi_cap_nhat        String?            @db.Uuid
  thoi_gian_tao         DateTime?          @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat    DateTime?          @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  linh_vuc              linh_vuc           @relation(fields: [id_linh_vuc], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_thuc_hanh_chinh_linh_vuc_linh_vuc")
  thu_tuc_hanh_chinh    thu_tuc_hanh_chinh @relation(fields: [id_thu_tuc_hanh_chinh], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_thuc_hanh_chinh_linh_vuc_thu_tuc")

  @@id([id_thu_tuc_hanh_chinh, id_linh_vuc])
}

model thu_tuc_hanh_chinh_mau_don {
  id                                                               String             @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  id_thu_tuc                                                       String             @db.Uuid
  id_mau_don                                                       String             @db.Uuid
  ghi_chu                                                          String?
  so_luong_ban_chinh                                               Int?
  so_luong_ban_sao                                                 Int?
  nguoi_tao                                                        String?            @db.Uuid
  nguoi_cap_nhat                                                   String?            @db.Uuid
  thoi_gian_tao                                                    DateTime?          @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat                                               DateTime?          @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  mau_don                                                          mau_don            @relation(fields: [id_mau_don], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_thu_tuc_hanh_chinh_mau_don_mau_don")
  nguoi_dung_thu_tuc_hanh_chinh_mau_don_nguoi_cap_nhatTonguoi_dung nguoi_dung?        @relation("thu_tuc_hanh_chinh_mau_don_nguoi_cap_nhatTonguoi_dung", fields: [nguoi_cap_nhat], references: [id], onUpdate: NoAction, map: "fk_thu_tuc_hanh_chinh_mau_don_nguoi_cap_nhat")
  nguoi_dung_thu_tuc_hanh_chinh_mau_don_nguoi_taoTonguoi_dung      nguoi_dung?        @relation("thu_tuc_hanh_chinh_mau_don_nguoi_taoTonguoi_dung", fields: [nguoi_tao], references: [id], onUpdate: NoAction, map: "fk_thu_tuc_hanh_chinh_mau_don_nguoi_tao")
  thu_tuc_hanh_chinh                                               thu_tuc_hanh_chinh @relation(fields: [id_thu_tuc], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_thu_tuc_hanh_chinh_mau_don_thu_tuc_hanh_chinh")

  @@id([id_thu_tuc, id_mau_don])
}

