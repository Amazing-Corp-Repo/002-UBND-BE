  is_active               Boolean  @default(true)
  is_delete               Boolean  @default(false)
  thoi_gian_tao           DateTime @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat      DateTime? @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)

  dang_ky_gap_lanh_dao dang_ky_gap_lanh_dao @relation(fields: [id_dang_ky_gap_lanh_dao], references: [id], onUpdate: NoAction, map: "fk_danh_gia_gap_lanh_dao_dang_ky")

  @@index([diem_tong], map: "idx_danh_gia_gap_lanh_dao_diem_tong")
}

model khung_gio_tiep_dan {
  id                 String        @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  id_lich_tiep_dan   String        @db.Uuid
  khung_gio          String        @db.VarChar(50)
  ma_quay            String        @db.VarChar(20)
  id_quay            String?       @db.Uuid
  id_ca_tiep_dan     String?       @db.Uuid                      // THÊM MỚI V2 — FK đến ca_tiep_dan
  suc_chua           Int           @default(2)
  is_active          Boolean?      @default(true)
  is_delete          Boolean?      @default(false)
  nguoi_tao          String?       @db.Uuid
  nguoi_cap_nhat     String?       @db.Uuid
  thoi_gian_tao      DateTime?     @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat DateTime?     @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  lich_tiep_dan      lich_tiep_dan @relation(fields: [id_lich_tiep_dan], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_khung_gio_tiep_dan_lich")
  quay_tiep_dan      quay_tiep_dan? @relation(fields: [id_quay], references: [id], onUpdate: NoAction, map: "fk_khung_gio_tiep_dan_quay")
  ca_tiep_dan        ca_tiep_dan?  @relation(fields: [id_ca_tiep_dan], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_khung_gio_tiep_dan_ca")
  dang_ky_tiep_dan   dang_ky_tiep_dan[]
  dang_ky_tiep_dan_cau_hinh dang_ky_tiep_dan[] @relation("DangKyTiepDan_CauHinhQuay")
  phan_cong_quay_tiep_dan phan_cong_quay_tiep_dan[]

  @@unique([id_lich_tiep_dan, khung_gio, ma_quay], map: "uq_khung_gio_tiep_dan_lich_slot_quay")
  @@unique([id_ca_tiep_dan, id_quay], map: "uq_khung_gio_tiep_dan_ca_quay_v2")
  @@index([id_lich_tiep_dan, khung_gio], map: "idx_khung_gio_tiep_dan_lich_slot")
  @@index([ma_quay], map: "idx_khung_gio_tiep_dan_ma_quay")
  @@index([id_quay], map: "idx_khung_gio_tiep_dan_id_quay")
  @@index([is_active, is_delete], map: "idx_khung_gio_tiep_dan_trang_thai_v2")
}

// Ca tiếp dân — khung thời gian trong lịch, không gắn sẵn quầy
model ca_tiep_dan {
  id                 String    @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  id_lich_tiep_dan   String    @db.Uuid
  gio_bat_dau        DateTime  @db.Time(0)
  gio_ket_thuc       DateTime  @db.Time(0)
  is_active          Boolean   @default(true)
  is_delete          Boolean   @default(false)
  nguoi_tao          String?   @db.Uuid
  nguoi_cap_nhat     String?   @db.Uuid
  thoi_gian_tao      DateTime  @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat DateTime? @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)

  lich_tiep_dan      lich_tiep_dan          @relation(fields: [id_lich_tiep_dan], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_ca_tiep_dan_lich")
  cau_hinh_quay      khung_gio_tiep_dan[]
  dang_ky_tiep_dan   dang_ky_tiep_dan[]

  @@unique([id_lich_tiep_dan, gio_bat_dau, gio_ket_thuc], map: "uq_ca_tiep_dan_lich_thoi_gian")
  @@index([id_lich_tiep_dan], map: "idx_ca_tiep_dan_id_lich")
  @@index([is_active, is_delete], map: "idx_ca_tiep_dan_trang_thai")
}

// Phân công cán bộ trực quầy theo ca
model phan_cong_quay_tiep_dan {
  id                    String    @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  id_cau_hinh_quay      String    @db.Uuid
  id_can_bo             String    @db.Uuid
  is_active             Boolean   @default(true)
  is_delete             Boolean   @default(false)
  nguoi_tao             String?   @db.Uuid
  nguoi_cap_nhat        String?   @db.Uuid
  thoi_gian_tao         DateTime  @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat    DateTime? @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)

  cau_hinh_quay         khung_gio_tiep_dan @relation(fields: [id_cau_hinh_quay], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_phan_cong_quay_cau_hinh")
  can_bo                nguoi_dung          @relation("PhanCongQuay_CanBo", fields: [id_can_bo], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([id_cau_hinh_quay], map: "uq_phan_cong_quay_cau_hinh")
  @@index([id_can_bo], map: "idx_phan_cong_quay_id_can_bo")
  @@index([is_active, is_delete], map: "idx_phan_cong_quay_trang_thai")
}

// Quầy tiếp dân — danh mục quầy
model quay_tiep_dan {
  id                 String    @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  ma_quay            String    @unique @db.VarChar(20)
  ten_quay           String    @db.VarChar(100)
  so_thu_tu          Int       @unique
  mo_ta              String?
  suc_chua_mac_dinh  Int       @default(2)
  vi_tri             String?   @db.VarChar(255)
  is_active          Boolean   @default(true)
  is_delete          Boolean   @default(false)
  nguoi_tao          String?   @db.Uuid
  nguoi_cap_nhat     String?   @db.Uuid
  thoi_gian_tao      DateTime  @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat DateTime? @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)

  khung_gio_tiep_dan khung_gio_tiep_dan[]
  dang_ky_tiep_dan   dang_ky_tiep_dan[]

  @@index([is_active, is_delete], map: "idx_quay_tiep_dan_trang_thai")
  @@index([so_thu_tu], map: "idx_quay_tiep_dan_so_thu_tu")
}

// Danh mục Thư viện số
model thu_vien_danh_muc {
  id                String             @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  ten               String             @db.VarChar(255)
  mo_ta             String?
  icon              String?            @db.VarChar(50)
  tone              String?            @db.VarChar(20)
  thu_tu            Int?
  is_active         Boolean?           @default(true)
  is_delete         Boolean?           @default(false)
  nguoi_tao         String?            @db.Uuid
  nguoi_cap_nhat    String?            @db.Uuid
  thoi_gian_tao     DateTime?          @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat DateTime?         @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thu_vien_tai_lieu thu_vien_tai_lieu[]

  @@index([is_active], map: "idx_thu_vien_danh_muc_is_active")
  @@index([is_delete], map: "idx_thu_vien_danh_muc_is_delete")
}

// Thư viện số — tài liệu (gộp sách/tài liệu/văn bản/bản đồ + pháp luật; cột nhóm luật để NULL)
model thu_vien_tai_lieu {
  id                     String                    @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  id_danh_muc            String?                   @db.Uuid
  loai                   String?                   @db.VarChar(30) // SACH | TAI_LIEU | VAN_BAN | BAN_DO | PHAP_LUAT
  tieu_de                String?                   @db.VarChar(255)
  tac_gia                String?                   @db.VarChar(255)
  mo_ta                  String?
  url_bia                String?                   @db.VarChar(500)
  so_luot_tai            BigInt?                   @default(0)
  is_featured            Boolean?                  @default(false)
  noi_dung               String?
  sections               Json?
  so_hieu                String?                   @db.VarChar(100)
  co_quan_ban_hanh       String?                   @db.VarChar(255)
  ngay_ban_hanh          DateTime?                 @db.Date
  ngay_hieu_luc          DateTime?                 @db.Date
  trang_thai_hieu_luc    String?                   @db.VarChar(50)
  chuong                 Json?
  trang_thai             String?                   @default("NHAP") @db.VarChar(30) // NHAP|CHO_DUYET|DA_DUYET|LUU_TRU
  pham_vi                String?                   @default("CONG_KHAI") @db.VarChar(30) // CONG_KHAI|NOI_BO|HAN_CHE
  nguon                  String?
  nguoi_duyet            String?                   @db.Uuid
  thoi_gian_duyet        DateTime?                 @db.Timestamp(6)
  ngay_dang              Int?
  ngon_ngu               String?                   @db.VarChar(10)
  is_active              Boolean?                  @default(true)
  is_delete              Boolean?                  @default(false)
  nguoi_tao              String?                   @db.Uuid
  nguoi_cap_nhat         String?                   @db.Uuid
  thoi_gian_tao          DateTime?                 @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat     DateTime?                 @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thu_vien_danh_muc      thu_vien_danh_muc?        @relation(fields: [id_danh_muc], references: [id], onUpdate: NoAction, map: "fk_thu_vien_tai_lieu_danh_muc")
  thu_vien_tai_lieu_tag  thu_vien_tai_lieu_tag[]
  thu_vien_tai_lieu_file thu_vien_tai_lieu_file[]
  thu_vien_tai_lieu_quyen thu_vien_tai_lieu_quyen[]

  @@index([loai], map: "idx_thu_vien_tai_lieu_loai")
  @@index([trang_thai], map: "idx_thu_vien_tai_lieu_trang_thai")
  @@index([pham_vi], map: "idx_thu_vien_tai_lieu_pham_vi")
  @@index([is_active], map: "idx_thu_vien_tai_lieu_is_active")
  @@index([is_delete], map: "idx_thu_vien_tai_lieu_is_delete")
}

// Thẻ phân loại tài liệu
model thu_vien_tag {
  id                     String                   @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  ten                    String                   @unique @db.VarChar(100)
  is_active              Boolean?                 @default(true)
  is_delete              Boolean?                 @default(false)
  nguoi_tao              String?                  @db.Uuid
  nguoi_cap_nhat         String?                  @db.Uuid
  thoi_gian_tao          DateTime?                @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat     DateTime?                @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thu_vien_tai_lieu_tag  thu_vien_tai_lieu_tag[]

  @@index([is_active], map: "idx_thu_vien_tag_is_active")
  @@index([is_delete], map: "idx_thu_vien_tag_is_delete")
}

// Bảng nối tài liệu ↔ tag
model thu_vien_tai_lieu_tag {
  id                String             @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  id_tai_lieu       String             @db.Uuid
  id_tag            String             @db.Uuid
  thu_vien_tai_lieu thu_vien_tai_lieu  @relation(fields: [id_tai_lieu], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tlt_tag_tai_lieu")
  thu_vien_tag      thu_vien_tag       @relation(fields: [id_tag], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tlt_tag_tag")

  @@unique([id_tai_lieu, id_tag])
}

// File / phiên bản tài liệu (storage DEV private)
model thu_vien_tai_lieu_file {
  id                    String             @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  id_tai_lieu           String             @db.Uuid
  ten_file              String?            @db.VarChar(255)
  duong_dan             String?            @db.VarChar(500)
  dinh_dang             String?            @db.VarChar(50) // MIME
  kich_thuoc_mb         Decimal?           @db.Decimal(10, 2)
  phien_ban             Int?
  la_phien_ban_hien_tai Boolean?           @default(false)
  mo_ta                 String?
  is_active             Boolean?           @default(true)
  is_delete             Boolean?           @default(false)
  nguoi_tao             String?            @db.Uuid
  nguoi_cap_nhat        String?            @db.Uuid
  thoi_gian_tao         DateTime?          @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat    DateTime?          @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thu_vien_tai_lieu     thu_vien_tai_lieu  @relation(fields: [id_tai_lieu], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tl_file_tai_lieu")

  @@index([id_tai_lieu], map: "idx_tl_file_id_tai_lieu")
  @@index([la_phien_ban_hien_tai], map: "idx_tl_file_la_phien_ban_hien_tai")
}

// Quyền truy cập tài liệu theo vai trò (dùng khi pham_vi = HAN_CHE)
model thu_vien_tai_lieu_quyen {
  id                String             @id @default(dbgenerated("public.uuid_generate_v4()")) @db.Uuid
  id_tai_lieu       String             @db.Uuid
  id_vai_tro        String             @db.Uuid
  nguoi_tao         String?            @db.Uuid
  nguoi_cap_nhat    String?            @db.Uuid
  thoi_gian_tao     DateTime?          @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thoi_gian_cap_nhat DateTime?         @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  thu_vien_tai_lieu thu_vien_tai_lieu  @relation(fields: [id_tai_lieu], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tl_quyen_tai_lieu")
  roles             roles              @relation(fields: [id_vai_tro], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tl_quyen_roles")

  @@index([id_tai_lieu], map: "idx_tl_quyen_id_tai_lieu")
  @@index([id_vai_tro], map: "idx_tl_quyen_id_vai_tro")
}
